# Скопировать в server/.env и заполнить.
# .env не коммитится и не должен попадать на сайт.

# --- сайт ---
XSISET_HOST=127.0.0.1
XSISET_PORT=8124
# демо-оплата: только локально, в проде 0
XSISET_DEMO=0
# секрет сессий; если пусто — создаётся server/data/session.key
XSISET_SECRET_KEY=
# фоновый сверщик оплат, секунды; 0 — выключить
XSISET_RECONCILE_SECONDS=120
# secure-cookie включать только за HTTPS
XSISET_COOKIE_SECURE=0

# --- Telegram ---
# имя бота без @; нужно и для deep link, и для входа через Telegram
XSISET_BOT=xsisetvpnbot
# токен бота: нужен для проверки подписи Telegram Login Widget
XSISET_BOT_TOKEN=

# --- CryptoBot (Crypto Pay) ---
XSISET_CRYPTOPAY_TOKEN=
XSISET_CRYPTO_ASSETS=USDT,TRX,TON
# XSISET_CRYPTOPAY_API=https://pay.crypt.bot/api

# --- Platega ---
XSISET_PLATEGA_MERCHANT_ID=
XSISET_PLATEGA_SECRET=
# XSISET_PLATEGA_API=https://app.platega.io
# числовой код метода оплаты, если нужен фиксированный
# XSISET_PLATEGA_METHOD=

# --- панель 3x-ui ---
XSISET_PANEL_URL=
XSISET_PANEL_TOKEN=
# id inbound'ов, куда добавляется клиент
XSISET_PANEL_INBOUNDS=5,11,13,16,17
# база ссылки-подписки, к ней добавляется /<subId>
XSISET_PANEL_SUB_BASE=
# live — реально создавать клиентов, dry — заглушка для тестов
XSISET_PANEL_MODE=live
XSISET_PANEL_VERIFY_TLS=true

# --- прочее ---
XSISET_ORDER_TTL_HOURS=24
XSISET_PAYMENT_TTL_MINUTES=60
XSISET_CONSENT_VERSION=2026-11-01
XSISET_CONTACT_EMAIL=xsiset@proton.me
