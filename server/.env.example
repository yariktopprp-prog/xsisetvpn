# Скопировать в server/.env и заполнить.
# .env не коммитится и не должен попадать на сайт.

# --- сайт ---
XSISET_HOST=127.0.0.1
XSISET_PORT=8124
# секрет для шифрования данных и подписи; если пусто — создаётся server/data/session.key
# ВНИМАНИЕ: смена ключа делает ранее сохранённые ключи нечитаемыми.
XSISET_SECRET_KEY=
# фоновый сверщик оплат и очистка БД, секунды; 0 — выключить
XSISET_RECONCILE_SECONDS=120
# доверять X-Forwarded-For только если сайт стоит за своим reverse-proxy
XSISET_TRUST_PROXY=0
# поддержка в Telegram (без @)
XSISET_SUPPORT=hkpde
# редакция согласия, которая сохраняется в заказе
XSISET_CONSENT_VERSION=2026-11-05

# --- Telegram ---
# имя бота без @ (используется в ссылках на сайте)
XSISET_BOT=xsisetvpnbot
# токен бота нужен только если бот работает отдельно от сайта
XSISET_BOT_TOKEN=

# --- CryptoBot (Crypto Pay) ---
XSISET_CRYPTOPAY_TOKEN=
XSISET_CRYPTO_ASSETS=USDT,TRX,TON
# XSISET_CRYPTOPAY_API=https://pay.crypt.bot/api

# --- Platega ---
XSISET_PLATEGA_MERCHANT_ID=
XSISET_PLATEGA_SECRET=
# XSISET_PLATEGA_API=https://app.platega.io
# числовой код метода оплаты, если нужен фиксированный
# XSISET_PLATEGA_METHOD=

# --- панель 3x-ui ---
XSISET_PANEL_URL=
XSISET_PANEL_TOKEN=
# id inbound'ов, куда добавляется клиент (через запятую)
XSISET_PANEL_INBOUNDS=5,11,13,16,17
# id inbound'ов обхода белых списков: отдельный клиент с общим subId и лимитом
XSISET_PANEL_LIMITED_IDS=17
# лимит трафика на узел обхода, ГБ на месяц
XSISET_PANEL_LIMIT_GB=20
# база ссылки-подписки; /sub добавится автоматически, если его нет
XSISET_PANEL_SUB_BASE=
# домен и порт подписки, если SUB_BASE не задан
XSISET_PANEL_DOMAIN=xsisetsweden3x-ui1.site
XSISET_PANEL_SUB_PORT=2096
# live — реально создавать клиентов, dry — заглушка для тестов
XSISET_PANEL_MODE=live
XSISET_PANEL_VERIFY_TLS=true
XSISET_PANEL_TIMEOUT=20
# старая схема выдачи: subId `_tmp` -> /root/untmp.sh по SSH
XSISET_PANEL_SSH_HOST=
XSISET_PANEL_SSH_PORT=22
XSISET_PANEL_SSH_USER=root
XSISET_PANEL_SSH_PASSWORD=
XSISET_PANEL_UNTMP_CMD=/root/untmp.sh

# --- прочее ---
XSISET_ORDER_TTL_HOURS=24
XSISET_PAYMENT_TTL_MINUTES=60
XSISET_CONTACT_EMAIL=xsiset@proton.me
